# ---------------------------------------------------------------------------
# TEMPLATE ONLY — Next.js never reads this file.
# Copy it to `.env.local` for the values to take effect:
#     cp .env.example .env.local
#
# All entries are optional; the site builds and runs with none of them set.
# ---------------------------------------------------------------------------

# Canonical URL. Used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cal.com booking target. A bare handle ("priyanshu-srivastava-3n0bty" or
# "priyanshu-srivastava-3n0bty/30min") or a full cal.com URL both work — the
# app strips the host before handing it to the embed.
# Set it and the contact CTA opens an embedded scheduler.
# Leave it empty and the CTA falls back to a prefilled email.
NEXT_PUBLIC_CAL_LINK=https://cal.com/priyanshu-srivastava-3n0bty

# GitHub personal access token (classic, no scopes needed for public data).
# With it, the activity card shows the real 12-month contribution calendar.
# Without it, the card falls back to recent public events and labels itself so.
GITHUB_TOKEN=
